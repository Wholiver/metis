# The metis-* workspace packages under vendor/ are not published to npm; they ship as
# compiled output. Track their dist/ in full so `pnpm install && pnpm build` works from a
# plain zip download of this repo (no submodules, no private registry).
!vendor/metis-agent-core/dist/
!vendor/metis-ai/dist/
!vendor/metis-tui/dist/

# ...but keep the noise out: source maps, Finder duplicate copies, stray tool dirs.
vendor/*/dist/**/*.map
vendor/*/dist/**/* 2/
vendor/*/dist/**/.claude/
