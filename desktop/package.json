{
	"name": "metis-desktop",
	"version": "1.1.0",
	"private": true,
	"description": "Electron desktop shell for Metis",
	"type": "module",
	"main": "main.cjs",
	"scripts": {
		"prepare:cli": "npm --prefix .. run build",
		"dev": "node scripts/dev.mjs",
		"prestart": "npm run prepare:cli",
		"start": "node scripts/dev.mjs",
		"build": "vite build && node scripts/build.mjs",
		"package:mac": "node scripts/package-macos.mjs",
		"package:win": "node scripts/package-windows.mjs",
		"package:win:installer": "node scripts/package-windows-installer.mjs",
		"start:dist": "electron dist/main.cjs"
	},
	"devDependencies": {
		"@electron/packager": "20.0.4",
		"@resvg/resvg-js": "^2.6.2",
		"@types/react": "^18.3.18",
		"@types/react-dom": "^18.3.5",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"electron": "43.1.1",
		"makensis": "^3.0.5",
		"nsis": "^0.0.0",
		"postcss": "^8.4.49",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.7.3",
		"vite": "^6.1.0"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"dompurify": "^3.2.4",
		"lucide-react": "^0.475.0",
		"marked": "^15.0.6",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tailwind-merge": "^3.0.1"
	}
}
